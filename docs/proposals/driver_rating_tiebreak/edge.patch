+  const result = await rankDriversByRoadDistance([
+    { ...candidates[0], rating: 4.1 },
+    { ...candidates[1], rating: 4.9 },
+  ], pickup, { fetcher: matrix([[1000], [1000]], [[60], [300]]) });
+  assert.deepEqual(result.map(x => x.user_id), ["driver-b", "driver-a"]);
+});
+
