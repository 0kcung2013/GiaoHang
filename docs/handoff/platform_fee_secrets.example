# Copy outside Git, fill with the merchant's sandbox values, then import as
# Supabase function secrets. Never commit the filled file.
VNPAY_TMN_CODE=REPLACE_WITH_SANDBOX_TERMINAL
VNPAY_HASH_SECRET=REPLACE_WITH_SANDBOX_HASH_SECRET
VNPAY_ENVIRONMENT=sandbox
# Production requires the exact HTTPS checkout URL from your VNPAY merchant.
# VNPAY_PAYMENT_URL=REPLACE_WITH_APPROVED_PRODUCTION_CHECKOUT_URL
# Optional: defaults to the current project's vnpay-order-return endpoint.
# VNPAY_ORDER_RETURN_URL=https://PROJECT_REF.supabase.co/functions/v1/vnpay-order-return
# Optional: omit to keep the default browser result page.
# VNPAY_ORDER_APP_RETURN_URL=YOUR_CONFIGURED_APP_DEEP_LINK
